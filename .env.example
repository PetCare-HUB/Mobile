# URL base da API Java do PetCare Hub.
# Copie este arquivo para .env e ajuste conforme o ambiente.
#
#   producao (Render):  https://petcare-hub-gokt.onrender.com
#   emulador Android:   http://10.0.2.2:8080
#   dispositivo fisico: http://<ip-da-sua-maquina>:8080
#
# O prefixo EXPO_PUBLIC_ e obrigatorio: sem ele o Expo nao injeta a
# variavel no bundle. Por isso o valor fica visivel no app -- nao
# coloque segredo aqui.
EXPO_PUBLIC_API_URL=https://petcare-hub-gokt.onrender.com

# URL base do servico da PetCare AI. Enquanto estiver vazia ou ausente, a
# aba de IA mostra que a assistente nao esta conectada e nao tenta chamar
# nada -- nao existe fallback para a API Java de proposito, porque apontar
# para ela daria 404 em producao sem ninguem perceber.
#
# O contrato que o app espera esta em docs/contrato-ia.md.
EXPO_PUBLIC_IA_API_URL=
